# POING API environment variables
#
# 1차 심사 필수: 한국관광공사 OpenAPI
# 공공데이터포털에서 받은 인증키를 넣습니다. 인코딩/디코딩 키 중 하나만 사용해도 됩니다.
KTO_SERVICE_KEY=
TOUR_API_SERVICE_KEY=
KTO_PHOTO_SERVICE_KEY=
KTO_POHANG_AREA_CODE=35
KTO_POHANG_SIGUNGU_CODE=23
KTO_MOBILE_OS=ETC
KTO_MOBILE_APP=POING

# 선택: 관광공사 연관 관광지, 집중률, 방문자수 API도 활용신청해야 합니다.
KTO_RELATED_SERVICE_KEY=
KTO_CONGESTION_SERVICE_KEY=
KTO_VISITOR_SERVICE_KEY=
KTO_RELATED_BASE_YM=202504
KTO_VISITOR_START_YMD=
KTO_VISITOR_END_YMD=

# 선택: Kakao 지도/길찾기
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
KAKAO_REST_API_KEY=
KAKAO_MOBILITY_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# 선택: 여행 저장/피드백
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 선택: AI 일정 문구 생성
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
